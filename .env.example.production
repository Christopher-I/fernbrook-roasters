# Production. On Railway these are service variables rather than a file.
#
# CRAFT_SECURITY_KEY must match the key the database was created with, or
# every encrypted value in it becomes unreadable. Generate it once and keep it.

CRAFT_APP_ID=
CRAFT_ENVIRONMENT=production
CRAFT_SECURITY_KEY=

# On Railway, reference the MySQL service, for example:
#   CRAFT_DB_SERVER=${{MySQL.MYSQLHOST}}
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=
CRAFT_DB_TABLE_PREFIX=

CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=false

PRIMARY_SITE_URL=https://example.up.railway.app

# Where the single Railway volume is mounted. storage/ and web/uploads are
# symlinked into this by the container entrypoint.
PERSIST_DIR=/mnt/persist

# Used once, on the first boot against an empty database.
CRAFT_ADMIN_USERNAME=admin
CRAFT_ADMIN_EMAIL=
CRAFT_ADMIN_PASSWORD=
CRAFT_SITE_NAME="Fernbrook Roasters"
CRAFT_SITE_LANGUAGE=en-GB
CRAFT_SEED_ON_INSTALL=1

# SMTP through a transactional provider's free tier.
MAIL_HOST=
MAIL_PORT=587
MAIL_USE_AUTH=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Fernbrook Roasters"
CONTACT_FORM_TO_EMAIL=
