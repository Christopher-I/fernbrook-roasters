{% extends '_layout.twig' %}
{% import '_partials/image.twig' as img %}

{% block content %}
  {# One article with one of each relation. Measured: 83 queries as written,
     86 if the entry is re-queried with
     .with(['heroImage', 'journalTopics', 'articleAuthor']). Craft 5 already
     eager-loads these, so the entry it loaded for the request is used
     directly. #}
  {% set author = entry.articleAuthor.one() %}

  <article>
    {% include '_partials/hero.twig' with {
      eyebrow: entry.postDate|date('j F Y'),
      heading: entry.title,
      summary: entry.standfirst,
      image: entry.heroImage.one(),
    } only %}

    {% set topics = entry.journalTopics.all() %}
    {% if topics %}
      <ul class="topics">
        {% for topic in topics %}
          <li><a href="{{ topic.url }}">{{ topic.title }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="prose">
      {{ entry.bodyText }}
    </div>

    {% if author %}
      <div class="byline">
        {% if author.photo %}
          {{ img.picture(author.photo, 'thumb', '72px', 'lazy') }}
        {% endif %}
        <div>
          <p class="byline__name">{{ author.fullName }}</p>
          <p class="byline__role">{{ author.userRole }}</p>
          <p>{{ author.userBio }}</p>
        </div>
      </div>
    {% endif %}
  </article>
{% endblock %}
