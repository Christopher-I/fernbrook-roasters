{% extends '_layout.twig' %}
{% set title = 'Page not found' %}

{% block content %}
  <div class="hero">
    <h1>That page is not here</h1>
    <p class="hero__summary">It may have moved, or the address may have a typo in it.</p>
  </div>

  <div class="prose">
    <p>Try the <a href="{{ url('journal') }}">journal</a>, the
      <a href="{{ url('services') }}">services</a>, or
      <a href="{{ url('search') }}">search the site</a>.</p>
  </div>
{% endblock %}
