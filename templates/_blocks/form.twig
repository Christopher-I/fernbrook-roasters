{# The first-party Contact Form plugin handles delivery. Spam protection is a
   honeypot: the fbr_website input is hidden from people, and the Fernbrook
   module drops any submission that fills it in. #}

{% set thankYou = craft.entries().section('pages').slug('thank-you').one() %}

<div class="block cta" id="contact-form">
  {% if block.formHeading %}<h2>{{ block.formHeading }}</h2>{% endif %}
  {% if block.formIntro %}<p>{{ block.formIntro|nl2br }}</p>{% endif %}

  {% set errors = craft.app.session.getFlash('error') %}
  {% set submission = submission ?? null %}

  {% if submission and submission.getErrors() %}
    <div class="notice notice--error" role="alert">
      <strong>That did not send.</strong>
      <ul>
        {% for error in submission.getErrors()|reduce((carry, e) => carry|merge(e), []) %}
          <li>{{ error }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <form method="post" action="" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('contact-form/send') }}
    {{ redirectInput(thankYou ? thankYou.uri : '') }}

    <div class="field">
      <label for="fromName">Your name</label>
      <input type="text" id="fromName" name="fromName" autocomplete="name" required
             value="{{ submission.fromName ?? '' }}">
    </div>

    <div class="field">
      <label for="fromEmail">Your email</label>
      <input type="email" id="fromEmail" name="fromEmail" autocomplete="email" required
             value="{{ submission.fromEmail ?? '' }}">
    </div>

    <div class="field">
      <label for="subject">What is it about?</label>
      <input type="text" id="subject" name="subject" value="{{ submission.subject ?? '' }}">
    </div>

    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message[body]" required>{{ submission.message.body ?? submission.message ?? '' }}</textarea>
    </div>

    <div class="hp" aria-hidden="true">
      <label for="fbr_website">Leave this field empty</label>
      <input type="text" id="fbr_website" name="fbr_website" tabindex="-1" autocomplete="off">
    </div>

    <button class="button" type="submit">Send message</button>
  </form>
</div>
