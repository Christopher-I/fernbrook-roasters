# vendor/ must not come from the host: the image installs its own
# production-only dependencies, and copying a dev vendor directory over the
# top leaves Yii registering extensions whose classes are no longer there.
vendor
.ddev
.git
.github
.idea
.vscode
node_modules
storage/runtime
storage/logs
storage/backups
web/cpresources
web/uploads
.env
.env.local
.DS_Store
tests
