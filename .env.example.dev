# Local development with DDEV. Copy to .env and fill in the two generated keys.
#
#   ddev craft setup/app-id
#   ddev craft setup/security-key
#
# https://craftcms.com/docs/5.x/configure.html

CRAFT_APP_ID=
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY=

# DDEV's database service
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_TABLE_PREFIX=

CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# DDEV serves over http locally unless mkcert's CA is installed.
PRIMARY_SITE_URL=http://fernbrook-roasters.ddev.site

# Mail goes to DDEV's Mailpit: ddev launch -m
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USE_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=hello@fernbrookroasters.test
MAIL_FROM_NAME="Fernbrook Roasters"
CONTACT_FORM_TO_EMAIL=hello@fernbrookroasters.test
